rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Data model: pf_members/{uid}: name(string 1..100), role(customer/admin/superadmin), createdAt(timestamp).
    // pf_shops/{uid}: ownerId, name, city, business phone, status, rules(list), rulesMap(map), createdAt.
    // pf_requests/{id}: immutable owner/vehicle/part/details/photos(0..4 small JPEG strings), status, previousStatus, acceptedOfferId, createdAt.
    // pf_offers/{requestId_uid}: immutable requestId, ownerId(customer), shopId, shopName, positive price, condition, delivery, note, status, createdAt.
    // pf_categories/{name}: name(string 1..80), createdAt(timestamp).
    // Email/passwords are owned by Firebase Auth, never stored in shared Firestore documents.
    function signed(){return request.auth != null;}
    // Trusted bootstrap identity. A verified email is required; registration order never grants admin.
    function founder(){return signed() && request.auth.token.email_verified == true && request.auth.token.email == 'suloanani1@gmail.com';}
    function superadmin(){return founder() || (signed() && get(/databases/$(database)/documents/pf_members/$(request.auth.uid)).data.role == 'superadmin');}
    function admin(){return superadmin() || (signed() && get(/databases/$(database)/documents/pf_members/$(request.auth.uid)).data.role == 'admin');}
    function deleting(id){return exists(/databases/$(database)/documents/pf_deletions/$(id));}
    function deletingBySuperadmin(id){return superadmin() && get(/databases/$(database)/documents/pf_deletions/$(id)).data.status=='pending';}
    function text(v,n){return v is string && v.size()>0 && v.size()<=n;}
    function validMember(d){return d.keys().hasAll(['name','role','createdAt']) && d.keys().hasOnly(['name','role','createdAt']) && text(d.name,100) && d.role in ['customer','admin','superadmin'] && d.createdAt is timestamp;}
    function validShop(d){return d.keys().hasAll(['ownerId','name','city','phone','status','rulesMap','createdAt']) && d.keys().hasOnly(['ownerId','name','city','phone','status','rulesMap','createdAt']) && text(d.ownerId,128) && text(d.name,100) && text(d.city,80) && text(d.phone,30) && d.phone.matches('[+0-9 ()-]{9,30}') && d.status in ['pending','approved','suspended'] && d.rulesMap is map && d.rulesMap.size()>0 && d.rulesMap.size()<=30 && d.rulesMap.values().hasOnly([true]) && d.createdAt is timestamp;}
    function photo(p){return p is string && p.size()<=180000 && p.matches('data:image/jpeg;base64,.*');}
    function validPhotos(p){return p is list && p.size()<=4 && (p.size()<1||photo(p[0])) && (p.size()<2||photo(p[1])) && (p.size()<3||photo(p[2])) && (p.size()<4||photo(p[3]));}
    function validRequest(d){return d.keys().hasAll(['ownerId','brand','model','year','engine','vin','category','part','description','city','condition','budget','photos','status','previousStatus','acceptedOfferId','createdAt']) && d.keys().hasOnly(['ownerId','brand','model','year','engine','vin','category','part','description','city','condition','budget','photos','status','previousStatus','acceptedOfferId','createdAt']) && text(d.ownerId,128) && text(d.brand,60) && text(d.model,80) && d.year is int && d.year>=1950 && d.year<=request.time.year()+1 && text(d.engine,80) && d.vin is string && (d.vin==''||d.vin.matches('[A-HJ-NPR-Z0-9]{17}')) && text(d.category,80) && text(d.part,120) && text(d.description,2000) && text(d.city,80) && d.condition in ['ნებისმიერი','ახალი','მეორადი'] && (d.budget==null||(d.budget is number&&d.budget>0&&d.budget<=1000000)) && validPhotos(d.photos) && d.status in ['open','closed','hidden'] && d.previousStatus in ['open','closed'] && (d.acceptedOfferId==null||text(d.acceptedOfferId,300)) && d.createdAt is timestamp;}
    function shopMatch(d){let s=get(/databases/$(database)/documents/pf_shops/$(request.auth.uid)).data;let m=s.rulesMap;return s.status=='approved' && (m.get(d.brand+'~'+d.model+'~'+d.category,false)==true || m.get(d.brand+'~*~'+d.category,false)==true || m.get('*~*~'+d.category,false)==true || m.get(d.brand+'~'+d.model+'~*',false)==true || m.get(d.brand+'~*~*',false)==true || m.get('*~*~*',false)==true);}
    function requestRead(d,id){return signed() && (admin() || d.ownerId==request.auth.uid || (d.status in ['open','closed'] && shopMatch(d)) || exists(/databases/$(database)/documents/pf_offers/$(id+'_'+request.auth.uid)));}
    function selectedOffer(d,id){let o=get(/databases/$(database)/documents/pf_offers/$(d.acceptedOfferId)).data;return o.requestId==id && o.ownerId==request.auth.uid;}
    function validOffer(d){return d.keys().hasAll(['requestId','ownerId','shopId','shopName','price','condition','delivery','note','status','createdAt']) && d.keys().hasOnly(['requestId','ownerId','shopId','shopName','price','condition','delivery','note','status','createdAt']) && text(d.requestId,128) && text(d.ownerId,128) && text(d.shopId,128) && text(d.shopName,100) && d.price is number && d.price>0 && d.price<=1000000 && d.condition in ['ახალი','მეორადი'] && text(d.delivery,120) && text(d.note,1000) && d.status=='pending' && d.createdAt is timestamp;}
    function validCategory(d){return d.keys().hasAll(['name','createdAt']) && d.keys().hasOnly(['name','createdAt']) && text(d.name,80) && d.createdAt is timestamp;}
    match /pf_members/{uid} {
      allow read: if signed() && (request.auth.uid==uid || superadmin());
      allow create: if signed() && uid==request.auth.uid && validMember(request.resource.data) && request.resource.data.createdAt==request.time && (request.resource.data.role=='customer'||(founder()&&request.resource.data.role=='superadmin'));
      allow update: if validMember(request.resource.data) && request.resource.data.createdAt==resource.data.createdAt && ((signed()&&uid==request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])) || (superadmin()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) && ((uid!=request.auth.uid&&resource.data.role!='superadmin'&&request.resource.data.role in ['customer','admin'])||(founder()&&uid==request.auth.uid&&request.resource.data.role=='superadmin'))));
    }
    match /pf_shops/{uid} {
      allow read: if signed() && (uid==request.auth.uid||resource.data.status=='approved'||admin());
      allow create: if signed()&&uid==request.auth.uid&&validShop(request.resource.data)&&request.resource.data.ownerId==uid&&request.resource.data.status=='pending'&&request.resource.data.createdAt==request.time;
      allow update: if validShop(request.resource.data)&&request.resource.data.ownerId==resource.data.ownerId&&request.resource.data.createdAt==resource.data.createdAt&&((signed()&&uid==request.auth.uid&&request.resource.data.status=='pending')||(admin()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])));
    }
    match /pf_requests/{id} {
      allow read: if requestRead(resource.data,id);
      allow delete: if deletingBySuperadmin(id);
      allow create: if !deleting(id)&&signed()&&validRequest(request.resource.data)&&request.resource.data.ownerId==request.auth.uid&&request.resource.data.status=='open'&&request.resource.data.previousStatus=='open'&&request.resource.data.acceptedOfferId==null&&request.resource.data.createdAt==request.time;
      allow update: if !deleting(id) && validRequest(request.resource.data) && ((signed()&&resource.data.ownerId==request.auth.uid&&resource.data.status=='open'&&request.resource.data.status=='closed'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','acceptedOfferId'])&&(request.resource.data.acceptedOfferId==null||selectedOffer(request.resource.data,id))) || (admin()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','previousStatus'])&&((request.resource.data.status=='hidden'&&resource.data.status!='hidden'&&request.resource.data.previousStatus==resource.data.status)||(resource.data.status=='hidden'&&request.resource.data.status==resource.data.previousStatus&&request.resource.data.previousStatus==resource.data.previousStatus))));
    }
    match /pf_offers/{id} {
      allow read: if signed() && (admin()||resource.data.ownerId==request.auth.uid||resource.data.shopId==request.auth.uid);
      allow create: if !deleting(request.resource.data.requestId)&&signed()&&validOffer(request.resource.data)&&id==request.resource.data.requestId+'_'+request.auth.uid&&request.resource.data.shopId==request.auth.uid&&request.resource.data.createdAt==request.time&&get(/databases/$(database)/documents/pf_requests/$(request.resource.data.requestId)).data.status=='open'&&get(/databases/$(database)/documents/pf_requests/$(request.resource.data.requestId)).data.ownerId==request.resource.data.ownerId&&request.resource.data.ownerId!=request.auth.uid&&shopMatch(get(/databases/$(database)/documents/pf_requests/$(request.resource.data.requestId)).data)&&request.resource.data.shopName==get(/databases/$(database)/documents/pf_shops/$(request.auth.uid)).data.name;
      allow delete: if deletingBySuperadmin(resource.data.requestId);
    }
    match /pf_categories/{id} {
      allow read: if signed();
      allow create,update: if superadmin()&&validCategory(request.resource.data);
    }
    // Private archive markers: panel-local visibility only, no shared record edits.
    // {type(enum), targetId(string <=300), label(string <=120), createdAt(timestamp)}.
    function archiveScope(panel,type,id){

      return (type=='requests' && !deleting(id) && ((panel in ['admin','superadmin'] && admin()) || (panel in ['customer','mobile-customer'] && get(/databases/$(database)/documents/pf_requests/$(id)).data.ownerId==request.auth.uid) || (panel=='shop' && requestRead(get(/databases/$(database)/documents/pf_requests/$(id)).data,id))))
        || (type=='offers' && !deleting(get(/databases/$(database)/documents/pf_offers/$(id)).data.requestId) && ((panel in ['admin','superadmin'] && admin()) || (panel in ['customer','mobile-customer'] && get(/databases/$(database)/documents/pf_offers/$(id)).data.ownerId==request.auth.uid) || (panel=='shop' && get(/databases/$(database)/documents/pf_offers/$(id)).data.shopId==request.auth.uid)))
        || (type=='shops' && ((panel in ['admin','superadmin'] && admin()) || (panel=='shop' && id==request.auth.uid && exists(/databases/$(database)/documents/pf_shops/$(id)))))
        || (type=='members' && panel=='superadmin' && superadmin() && exists(/databases/$(database)/documents/pf_members/$(id)))
        || (type=='categories' && panel=='superadmin' && superadmin());
    }
    function deletableArchive(d){return (d.type=='requests' && deletingBySuperadmin(d.targetId)) || (d.type=='offers' && deletingBySuperadmin(get(/databases/$(database)/documents/pf_offers/$(d.targetId)).data.requestId));}
    match /pf_archives/{uid}/panels/{panel}/items/{id} {
      allow read: if signed() && (request.auth.uid==uid || deletableArchive(resource.data));
      allow delete: if signed() && (request.auth.uid==uid || deletableArchive(resource.data));
      allow create,update: if signed() && request.auth.uid==uid
        && panel in ['customer','mobile-customer','shop','admin','superadmin']
        && request.resource.data.keys().hasAll(['type','targetId','label','createdAt'])
        && request.resource.data.keys().hasOnly(['type','targetId','label','createdAt'])
        && request.resource.data.type in ['requests','offers','shops','members','categories']
        && text(request.resource.data.targetId,300) && text(request.resource.data.label,120)
        && request.resource.data.createdAt==request.time
        && id==request.resource.data.type+'_'+request.resource.data.targetId
        && archiveScope(panel,request.resource.data.type,request.resource.data.targetId);
    }
    // Commerce is additive: existing requests, offers, roles and archives retain their schema.
    // pf_orders/{requestId}: immutable participants/offer, monotonic version, timestamps,
    // status(confirmed/preparing/shipped/delivered/completed/cancelled), dispute(none/open/resolved).
    // events/{version}: immutable actor, state snapshot, bounded reason, server timestamp.
    // pf_messages: immutable offer-scoped participant text, never editable or deletable.
    // pf_inbox/{uid}/receipts: private read markers; notifications derive from real records.
    // pf_devices/{uid}/tokens: private Android FCM tokens; server-only sending.
    function isOwner(uid){return signed() && request.auth.uid==uid;}
    function participant(d){return signed() && (d.ownerId==request.auth.uid||d.shopId==request.auth.uid);}
    function validOrder(d){return d.keys().hasAll(['requestId','offerId','ownerId','shopId','status','dispute','version','createdAt','updatedAt']) && d.keys().hasOnly(['requestId','offerId','ownerId','shopId','status','dispute','version','createdAt','updatedAt']) && text(d.requestId,128) && text(d.offerId,300) && text(d.ownerId,128) && text(d.shopId,128) && d.ownerId!=d.shopId && d.status in ['confirmed','preparing','shipped','delivered','completed','cancelled'] && d.dispute in ['none','open','resolved'] && d.version is int && d.version>=0 && d.version<1000000 && d.createdAt is timestamp && d.updatedAt is timestamp;}
    function validEvent(e){return e.keys().hasAll(['actorId','kind','status','dispute','note','version','createdAt']) && e.keys().hasOnly(['actorId','kind','status','dispute','note','version','createdAt']) && text(e.actorId,128) && e.kind in ['confirmed','preparing','shipped','delivered','completed','cancelled','dispute','resolve'] && e.status in ['confirmed','preparing','shipped','delivered','completed','cancelled'] && e.dispute in ['none','open','resolved'] && text(e.note,1000) && e.version is int && e.version>=0 && e.version<1000000 && e.createdAt==request.time;}
    function matchingEvent(id,d){let e=getAfter(/databases/$(database)/documents/pf_orders/$(id)/events/$(string(d.version))).data;return validEvent(e) && e.actorId==request.auth.uid && e.version==d.version && e.status==d.status && e.dispute==d.dispute;}
    function orderSelection(id,d){let o=get(/databases/$(database)/documents/pf_offers/$(d.offerId)).data;let r=getAfter(/databases/$(database)/documents/pf_requests/$(id)).data;return d.requestId==id && o.requestId==id && o.ownerId==d.ownerId && o.shopId==d.shopId && r.ownerId==d.ownerId && r.acceptedOfferId==d.offerId && r.status=='closed';}
    function statusStep(a,b){return (a=='confirmed'&&b=='preparing')||(a=='preparing'&&b=='shipped')||(a=='shipped'&&b=='delivered')||(a=='delivered'&&b=='completed');}
    function validOrderChange(id,a,b){
      let e=getAfter(/databases/$(database)/documents/pf_orders/$(id)/events/$(string(b.version))).data;
      return b.diff(a).affectedKeys().hasOnly(['status','dispute','version','updatedAt']) && b.version==a.version+1 && b.updatedAt==request.time && matchingEvent(id,b) && (
        (b.status!=a.status && b.dispute==a.dispute && e.kind==b.status && (a.dispute!='open'||admin()) && (
          (statusStep(a.status,b.status) && (admin()||(b.status=='completed'?isOwner(a.ownerId):isOwner(a.shopId)))) ||
          (b.status=='cancelled' && ((a.status in ['confirmed','preparing'] && (participant(a)||admin())) || (a.status in ['shipped','delivered']&&admin())))
        )) ||
        (b.status==a.status && a.dispute=='none' && b.dispute=='open' && e.kind=='dispute' && participant(a)) ||
        (b.status==a.status && a.dispute=='open' && b.dispute=='resolved' && e.kind=='resolve' && admin())
      );
    }
    match /pf_orders/{id} {
      allow get: if signed() && (admin() || (resource!=null && participant(resource.data)) || get(/databases/$(database)/documents/pf_requests/$(id)).data.ownerId==request.auth.uid);
      allow list: if signed() && (admin()||participant(resource.data));
      allow create: if !deleting(id) && signed() && validOrder(request.resource.data) && isOwner(request.resource.data.ownerId) && orderSelection(id,request.resource.data) && request.resource.data.status=='confirmed' && request.resource.data.dispute=='none' && request.resource.data.version==0 && request.resource.data.createdAt==request.time && request.resource.data.updatedAt==request.time && matchingEvent(id,request.resource.data) && getAfter(/databases/$(database)/documents/pf_orders/$(id)/events/0).data.kind=='confirmed';
      allow update: if !deleting(id) && signed() && (participant(resource.data)||admin()) && validOrder(request.resource.data) && validOrderChange(id,resource.data,request.resource.data);
      allow delete: if deletingBySuperadmin(id);
      match /events/{version} {
        allow delete: if deletingBySuperadmin(id);
        allow read: if signed() && (admin()||participant(get(/databases/$(database)/documents/pf_orders/$(id)).data));
        allow create: if !deleting(id) && signed() && validEvent(request.resource.data) && request.resource.data.actorId==request.auth.uid && version==string(request.resource.data.version) && matchingEvent(id,getAfter(/databases/$(database)/documents/pf_orders/$(id)).data) && getAfter(/databases/$(database)/documents/pf_orders/$(id)).data.version==request.resource.data.version && (!exists(/databases/$(database)/documents/pf_orders/$(id)) || get(/databases/$(database)/documents/pf_orders/$(id)).data.version+1==request.resource.data.version);
      }
    }
    function validMessage(d){return d.keys().hasAll(['offerId','requestId','ownerId','shopId','senderId','recipientId','text','createdAt']) && d.keys().hasOnly(['offerId','requestId','ownerId','shopId','senderId','recipientId','text','createdAt']) && text(d.offerId,300) && text(d.requestId,128) && text(d.ownerId,128) && text(d.shopId,128) && text(d.senderId,128) && text(d.recipientId,128) && text(d.text,2000) && d.createdAt==request.time;}
    function messageOffer(d){let o=get(/databases/$(database)/documents/pf_offers/$(d.offerId)).data;return o.requestId==d.requestId && o.ownerId==d.ownerId && o.shopId==d.shopId && d.ownerId!=d.shopId && d.senderId==request.auth.uid && ((d.senderId==d.ownerId&&d.recipientId==d.shopId)||(d.senderId==d.shopId&&d.recipientId==d.ownerId));}
    match /pf_messages/{id} {
      allow read: if signed() && (admin() || participant(resource.data) || resource.data.recipientId==request.auth.uid);
      allow create: if !deleting(request.resource.data.requestId) && signed() && validMessage(request.resource.data) && participant(request.resource.data) && messageOffer(request.resource.data);
      allow delete: if deletingBySuperadmin(resource.data.requestId);
    }
    match /pf_inbox/{uid}/receipts/{id} {
      allow read,delete: if isOwner(uid);
      allow create,update: if isOwner(uid) && id.size()<=400 && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt==request.time;
    }
    function validDevice(d){return d.keys().hasAll(['token','platform','updatedAt']) && d.keys().hasOnly(['token','platform','updatedAt']) && text(d.token,4096) && d.platform=='android' && d.updatedAt==request.time;}
    match /pf_devices/{uid}/tokens/{id} {
      allow read,delete: if isOwner(uid);
      allow create,update: if isOwner(uid) && id.matches('[a-f0-9]{64}') && validDevice(request.resource.data);
    }
    // Content-free permanent deletion lock: blocks recreation and supports interrupted cascades.
    function validDeletion(d){return d.keys().hasAll(['requestedBy','status','createdAt','updatedAt']) && d.keys().hasOnly(['requestedBy','status','createdAt','updatedAt']) && text(d.requestedBy,128) && d.status in ['pending','completed'] && d.createdAt is timestamp && d.updatedAt==request.time;}
    match /pf_deletions/{id} {
      allow read: if superadmin();
      allow create: if superadmin() && text(id,128) && validDeletion(request.resource.data) && request.resource.data.requestedBy==request.auth.uid && request.resource.data.status=='pending' && request.resource.data.createdAt==request.time && exists(/databases/$(database)/documents/pf_requests/$(id));
      allow update: if superadmin() && validDeletion(request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && resource.data.status=='pending' && request.resource.data.status=='completed';
    }
    match /{document=**} {allow read,write: if false;}
  }
}
